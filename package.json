{
  "name": "backend-nest-boilerplate",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && tsc-alias -p tsconfig.base.json",
    "start": "node dist/api/main.js",
    "dev": "tsc -b --watch",
    "test": "jest",
    "test:db": "node scripts/setup-test-db.mjs",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:watch": "jest --watch",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^3.2.1",
    "@nestjs-cls/transactional-adapter-prisma": "^1.3.5",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "amqplib": "^2.0.1",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-cls": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.1",
    "jest": "^30.4.2",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  }
}
